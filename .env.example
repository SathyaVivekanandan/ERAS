# ERAS environment template.
# Copy this file to ".env" and change values as needed. Never commit ".env".
# There are no API keys: ERAS uses only simulated demo data and OpenStreetMap tiles.

# Port the web server listens on (http://localhost:3000)
PORT=3000

# Location of the SQLite database file (created automatically on first start)
DB_PATH=data/eras.db

# Password given to every DEMO user account when the database is first seeded.
# Change it before showing the app on a shared network.
DEMO_PASSWORD=change-me-demo

# How long a login session lasts, in hours
SESSION_TTL_HOURS=12

# If "true", police must enter an action note before marking a request Solved
REQUIRE_SOLVED_NOTE=false

# Route/traffic data older than this many minutes is treated as stale
STALE_AFTER_MINUTES=15
